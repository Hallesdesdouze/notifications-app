{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Halles des Douze - Notifications",
    "version": "0.1.2",
    "identifier": "fr.halles-des-douze.notifier",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Halles des Douze - Notifications",
                "width": 380,
                "height": 560,
                "resizable": false,
                "center": true,
                "backgroundThrottling": "disabled"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "languages": ["French"]
            }
        }
    }
}
